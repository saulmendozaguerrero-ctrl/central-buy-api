# ─────────────────────────────────────────────
#  CENTRAL BUY API — Environment Variables
#  Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3001
API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# ─── Database ───────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/centralbuy
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASS=postgres
DATABASE_NAME=centralbuy

# ─── Redis ──────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Clerk (Auth) ───────────────────────────
# Get from https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_PLACEHOLDER
CLERK_PUBLISHABLE_KEY=pk_test_PLACEHOLDER
CLERK_WEBHOOK_SECRET=whsec_PLACEHOLDER

# ─── Stripe (Payments) ──────────────────────
# Get from https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER
STRIPE_PRICE_PARTICULAR=price_PLACEHOLDER   # €4.99/month
STRIPE_PRICE_EMPRESA=price_PLACEHOLDER      # €9.99/month

# ─── Resend (Email) ─────────────────────────
# Get from https://resend.com
RESEND_API_KEY=re_PLACEHOLDER
FROM_EMAIL=noreply@centralbuy.com

# ─── Cloudflare R2 (Storage) ────────────────
R2_ACCOUNT_ID=PLACEHOLDER
R2_ACCESS_KEY=PLACEHOLDER
R2_SECRET_KEY=PLACEHOLDER
R2_BUCKET=centralbuy-files
R2_PUBLIC_URL=https://files.centralbuy.com

# ─── JWT (internal signing) ─────────────────
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# ─── Future: Platts API ─────────────────────
# PLATTS_API_KEY=xxx
# PLATTS_API_URL=https://api.platts.com/v1
